PORT=3001

# mock = bundled sample players/matches, no API key needed
# riot = live Riot API (requires RIOT_API_KEY; match/rank data additionally
#        requires an approved production key with RSO, not a personal dev key)
DATA_SOURCE=mock

RIOT_API_KEY=
RIOT_CLIENT_ID=
RIOT_CLIENT_SECRET=

# Groq API key, used for AI-generated roast text (optional — falls back to
# rule-based templates if unset or the call fails)
AI_API_KEY=
